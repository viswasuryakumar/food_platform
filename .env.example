# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
#
# `npm run setup` reads this file (or your shell environment) and generates the
# per-service .env files. Any secret left blank below is randomly generated.

# ---- Required ----
# MongoDB connection string. Use a database user scoped to this app only.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ---- Optional: generated automatically if left blank ----
# Signs and verifies user JWTs. Must be identical across gateway and services.
JWT_SECRET=

# Shared secret for service-to-service calls (e.g. marking an order paid).
# Prevents anyone who can reach a service port from forging internal requests.
INTERNAL_SERVICE_TOKEN=

# ---- Frontend ----
VITE_API_URL=http://localhost:3000

# ---- AI agent (services/ai-agent/.env) ----
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Docker ----
DOCKER_USERNAME=your-dockerhub-username
